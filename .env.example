# =============================================================================
# Polybot — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Polymarket CLOB
# -----------------------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Your Ethereum wallet private key (hex, with or without 0x prefix).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# 你的 Polymarket 存款钱包地址（在 Polymarket 网页右上角 Profile 可以看到）。
# 当签名密钥与存款钱包地址一致时，可以留空。
# 当你使用代理私钥签名时，必须填入实际的存款钱包地址。
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# L2 API credentials — leave blank to let the bot derive them on startup.
API_KEY=
API_SECRET=
API_PASSPHRASE=

# -----------------------------------------------------------------------------
# Target market — BTC 5-minute up/down
# 填写某个已知市场 slug 中的 Unix 时间戳，例如：
#   btc-updown-5m-1780073700  →  BTC_5MIN_START_TIMESTAMP=1780073700
# Bot 会从该时间戳出发，自动跟踪后续每个 5-min 市场。
# -----------------------------------------------------------------------------
BTC_5MIN_START_TIMESTAMP=1780077900

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://polybot:secret@localhost:5432/polybot

# -----------------------------------------------------------------------------
# Bot runtime
# -----------------------------------------------------------------------------
# Set DRY_RUN=false only when you are ready to trade real funds.
DRY_RUN=true

# How often (seconds) to poll market data and run the strategy.
POLL_INTERVAL_SECONDS=30

# Hard limit per order (USDC notional).
MAX_ORDER_SIZE_USDC=50.0

# Total maximum open exposure per market side (USDC).
MAX_POSITION_SIZE_USDC=200.0

# -----------------------------------------------------------------------------
# Strategy — BTC 5-min
# -----------------------------------------------------------------------------
# 是否启用方向性策略（设为 false 可单独只跑套利）
BTC_5MIN_ENABLED=false

# 主方向押注金额（USDC）
STRATEGY_FOK_BET_USDC=0
# FAK 市价单押注金额（USDC），尽量成交剩余取消，设为 0 可关闭
STRATEGY_FAK_BET_USDC=2
STRATEGY_GTC_BET_USDC=0

# 对冲方向押注金额（USDC），设为 0 可关闭对冲
#STRATEGY_HEDGE_BET_USDC=1.0
STRATEGY_HEDGE_BET_USDC=0

# 距结算多少秒内开始入场（建议 60~180）
STRATEGY_ENTRY_SECONDS=60

# 目标入场价格（0~1），best_ask 落在此价格 ±tolerance 范围内才触发下单
STRATEGY_TARGET_PRICE=0.90

# 价格容忍带（0~1），例如 0.03 = ±3%，即 [0.77, 0.83]
STRATEGY_PRICE_TOLERANCE=0.03

# 限价单偏移：实际下单价 = best_ask - offset
# 0.00 → 直接以 best_ask 挂限价单（贴近市价，成交概率高）
# 0.01 → 比 best_ask 低 1 分挂单（更省钱，但可能不成交）
STRATEGY_LIMIT_PRICE_OFFSET=0.00

# 止损单类型：GTC（挂单等待成交）/ FOK（全部成交或取消）/ FAK（尽量成交剩余取消）
STRATEGY_STOP_LOSS_ORDER_TYPE=FAK
# 止损阈值（%，正数）：持仓亏损达到此百分比时立即平仓。
# 例如 20 = 亏损 20% 时触发止损。设为 0 可关闭止损功能。
STRATEGY_STOP_LOSS_PCT=20

# 止盈配置
STRATEGY_TAKE_PROFIT_PCT=20.0       # 盈利 20% 时触发，设为 0 关闭
STRATEGY_TAKE_PROFIT_ORDER_TYPE=FAK  # GTC / FOK / FAK

# -----------------------------------------------------------------------------
# Strategy — btc_arb（YES/NO 价差无风险套利）
#
# 原理：
#   Merge 套利：YES_ask + NO_ask < $1  → 并发买入双边 → merge → 得到 $1 pUSD
#   Split 套利：YES_bid + NO_bid > $1  → split $1 pUSD → 并发卖出双边
# 与 BTC 涨跌结果完全无关，属于纯无风险价差交易。
# 需将 ARB_ENABLED 设为 true 才会激活；可与 btc_5min 同时运行。
# -----------------------------------------------------------------------------
ARB_ENABLED=true

# 观察模式：仅打印订单簿市价和套利机会，不执行任何交易
# 上线前建议先开启此模式观察市场，确认阈值合理后再关闭正式交易。
# 开启方式：ARB_ENABLED=true + ARB_OBSERVE_MODE=true（DRY_RUN 不影响此功能）
ARB_OBSERVE_MODE=false

# 触发阈值（扣除 gas 后仍有利润才触发）
# Merge：YES_ask + NO_ask ≤ (1 - ARB_MIN_MERGE_SPREAD) 时触发
# Split：YES_bid + NO_bid ≥ (1 + ARB_MIN_SPLIT_SPREAD) 时触发
ARB_MIN_MERGE_SPREAD=0.005
ARB_MIN_SPLIT_SPREAD=0.005

# 资金规模（USDC）
ARB_BASE_TRADE_USDC=1.0        # 单次套利基础规模
ARB_MAX_TRADE_USDC=1.0        # 单次套利上限

# 两次套利之间的冷却期（秒），主要用于等待链上 merge/split tx 确认
ARB_COOLDOWN_SECONDS=3.0

# 订单簿最小深度（shares）。低于此值认为流动性不足，跳过套利。
# 建议设置为 ARB_BASE_TRADE_USDC / 预期价格 的 2 倍以上，降低单边成交风险。
ARB_LIQUIDITY_MIN_SIZE=10.0

# FOK 买/卖单的价格滑点容忍（USDC 偏移）
# 买单实际价格最多高于 ask 此值；卖单实际价格最多低于 bid 此值
ARB_SLIPPAGE_TOLERANCE=0.002

# Polygon 链上 gas 费用估算（USDC），用于净利润门槛过滤
# Polygon 通常 < $0.01；设偏高可提高触发门槛，减少低利润交易
ARB_ESTIMATED_GAS_USDC=0.005

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/polybot.log
LOG_CONSOLE=false

# -----------------------------------------------------------------------------
# Election / multi-choice market monitoring
# -----------------------------------------------------------------------------
# 是否启用多选市场套利监听
ELECTION_ARB_ENABLED=false

# 观察模式：true = 仅打印机会，不执行交易（建议首次启用时保持 true）
ELECTION_ARB_OBSERVE_MODE=true

# 要监听的 Polymarket 事件 slug，即事件 URL 最后一段路径
# 示例：https://polymarket.com/event/democratic-presidential-nominee-2028
#        修改此值即可切换到任意多选市场（大选、颁奖礼、体育赛事等）
ELECTION_MARKET_SLUG=democratic-presidential-nominee-2028

# 套利触发阈值（USDC）
ELECTION_ARB_MIN_MERGE_SPREAD=0.005
ELECTION_ARB_MIN_SPLIT_SPREAD=0.005

# 单次套利规模（USDC）
ELECTION_ARB_BASE_TRADE_USDC=20.0
ELECTION_ARB_MAX_TRADE_USDC=100.0

# 冷却时间（秒）与最小流动性要求
ELECTION_ARB_COOLDOWN_SECONDS=5.0
ELECTION_ARB_LIQUIDITY_MIN_SIZE=5.0
