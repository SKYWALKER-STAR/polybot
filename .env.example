# =============================================================================
# Polybot — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Polymarket CLOB
# -----------------------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Your Ethereum wallet private key (hex, with or without 0x prefix).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# L2 API credentials — leave blank to let the bot derive them on startup.
API_KEY=
API_SECRET=
API_PASSPHRASE=

# -----------------------------------------------------------------------------
# Target market — BTC 5-minute up/down
# Find these values on https://polymarket.com or via the CLOB API.
# -----------------------------------------------------------------------------
BTC_5MIN_CONDITION_ID=0xYOUR_CONDITION_ID
BTC_5MIN_YES_TOKEN_ID=0xYOUR_YES_TOKEN_ID
BTC_5MIN_NO_TOKEN_ID=0xYOUR_NO_TOKEN_ID

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://polybot:secret@localhost:5432/polybot

# -----------------------------------------------------------------------------
# Bot runtime
# -----------------------------------------------------------------------------
# Set DRY_RUN=false only when you are ready to trade real funds.
DRY_RUN=true

# How often (seconds) to poll market data and run the strategy.
POLL_INTERVAL_SECONDS=30

# Hard limit per order (USDC notional).
MAX_ORDER_SIZE_USDC=50.0

# Total maximum open exposure per market side (USDC).
MAX_POSITION_SIZE_USDC=200.0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/polybot.log
